
#Область СлужебныйПрограммныйИнтерфейс

Функция ОписаниеРеакцийНабора() Экспорт
	
	РеакцииНабора = Новый СписокЗначений;
	
	РеакцииНабора.Добавить("НР1_ПалецВверх",    нСтр("ru='Лайк'", "ru"));
	РеакцииНабора.Добавить("НР1_ПалецВниз",     нСтр("ru='Дизлайк'", "ru"));
	РеакцииНабора.Добавить("НР1_КрасноеСердце", нСтр("ru='Красное сердце'", "ru"));
	РеакцииНабора.Добавить("НР1_Череп",         нСтр("ru='Череп'", "ru"));
	
	Возврат РеакцииНабора;
	
КонецФункции

