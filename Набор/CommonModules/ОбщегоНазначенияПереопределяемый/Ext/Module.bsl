
&После("ПередЗапускомПрограммы")
Процедура НР1_ПередЗапускомПрограммы()
	
	Если ОбщегоНазначения.ПодсистемаСуществует("РКЦ_Реакции") Тогда
		Модуль = ОбщегоНазначения.ОбщийМодуль("РКЦ_Реакции");
		Модуль.ДобавитьОписаниеНабора(
			"НаборРеакций1",
			нСтр("ru='Набор реакций №1'", "ru"),
			"НР1_РеакцииСлужебный"
		);
	КонецЕсли;
	
КонецПроцедуры
