
&После("ПередЗапускомПрограммы")
Процедура НР1_ПередЗапускомПрограммы()
	
	НаборыРеакций = Новый Массив(ПараметрыСеанса["РКЦ_ПодключенныеНаборыРеакций"]);
	НовыйНабор = Новый Структура("ИмяРасширения, Наименование, Префикс",
		"НаборРеакций1", нСтр("ru='Набор реакций №1'", "ru"), "НР1_");
	НаборыРеакций.Добавить(Новый ФиксированнаяСтруктура(НовыйНабор));
	ПараметрыСеанса.РКЦ_ПодключенныеНаборыРеакций = Новый ФиксированныйМассив(НаборыРеакций);
	
КонецПроцедуры
