
#Область СлужебныйПрограммныйИнтерфейс
 
Функция ОбъектыСРеакциями() Экспорт
	
	СвойстваОбъектовПодсистемы = Новый ТаблицаЗначений;
	СвойстваОбъектовПодсистемы.Колонки.Добавить("Метаданные");
	СвойстваОбъектовПодсистемы.Колонки.Добавить("РеквизитПолучательОповещения", Новый ОписаниеТипов("Строка"));
	
	РКЦ_РеакцииПереопределяемый.ПриОпределенииОбъектовСРеакциями(СвойстваОбъектовПодсистемы);
	
	Результат = Новый Соответствие;
	
	Для Каждого СвойстваОбъекта Из СвойстваОбъектовПодсистемы Цикл
		СтруктураСвойств = Новый Структура("РеквизитПолучательОповещения");
		ЗаполнитьЗначенияСвойств(СтруктураСвойств, СвойстваОбъекта);
		Результат.Вставить(СвойстваОбъекта.Метаданные, СвойстваОбъекта);
	КонецЦикла;
	
	Возврат Новый ФиксированноеСоответствие(Результат);
	
КонецФункции

Функция ДанныеРеакций() Экспорт
	
	Результат = Новый Структура("ПредопределенныеРеакции, ПользовательскиеРеакции");
	
	ПредопределенныеРеакции = Новый Соответствие;
	
	НаборыРеакций = ПараметрыСеанса.РКЦ_ПодключенныеНаборыРеакций;
	
	Для Каждого Набор Из НаборыРеакций Цикл
		
		МодульНабора = ОбщегоНазначения.ОбщийМодуль(Набор.ИмяМодуля);
		РеакцииНабора = МодульНабора.ОписаниеРеакцийНабора();
		
		Для Каждого Реакция Из РеакцииНабора Цикл
			
			СвойстваРеакции = Новый Структура;
			СвойстваРеакции.Вставить("Значение",      Реакция.Значение);
			СвойстваРеакции.Вставить("Представление", Реакция.Представление);
			СвойстваРеакции.Вставить("Картинка",      БиблиотекаКартинок[Реакция.Значение]);
			
			ПредопределенныеРеакции.Вставить(Реакция.Значение, Новый ФиксированнаяСтруктура(СвойстваРеакции));
			
		КонецЦикла;
		
	КонецЦикла;
	Результат.ПредопределенныеРеакции = Новый ФиксированноеСоответствие(ПредопределенныеРеакции);
	
	// Пользовательские реакции
	ПользовательскиеРеакции = Новый Соответствие;
	
	ПользовательскаяРеакция = Справочники.РКЦ_Реакции.Выбрать();
	Пока ПользовательскаяРеакция.Следующий() Цикл
		
		Картинка = ПользовательскаяРеакция.Картинка.Получить();
		
		Если Картинка.Высота() > 64 Или Картинка.Ширина() > 64 Тогда
			Обрабатываемая = Новый ОбрабатываемаяКартинка(Картинка);
			Обрабатываемая.УстановитьРазмер(64, 64);
			Картинка = Обрабатываемая.ПолучитьКартинку();
		КонецЕсли;
		
		СвойстваРеакции = Новый Структура;
		УникальныйИдентификатор = Строка(ПользовательскаяРеакция.Ссылка.УникальныйИдентификатор());
		СвойстваРеакции.Вставить("Значение",      УникальныйИдентификатор);
		СвойстваРеакции.Вставить("Представление", ПользовательскаяРеакция.Наименование);
		СвойстваРеакции.Вставить("Картинка",      Картинка);
		СвойстваРеакции.Вставить("Ссылка",        ПользовательскаяРеакция.Ссылка);
		
		ПользовательскиеРеакции.Вставить(УникальныйИдентификатор, Новый ФиксированнаяСтруктура(СвойстваРеакции));
		
	КонецЦикла;
	Результат.ПользовательскиеРеакции = Новый ФиксированноеСоответствие(ПользовательскиеРеакции);
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

Функция НастройкиРеакций() Экспорт
	
	ПерсональныеНастройки = Новый Структура;
	
	РКЦ_РеакцииСлужебный.ДобавитьНастройкиРеакций(ПерсональныеНастройки);
	
	Возврат Новый ФиксированнаяСтруктура(ПерсональныеНастройки);
	
КонецФункции

Функция ПолучатьОповещения(ИмяПользователя = "") Экспорт
	
	ПолучатьОповещения = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(
		"РКЦ_ПользовательскиеНастройкиРеакций", "ПолучатьОповещения", , , ИмяПользователя
	);
	
	Если ПолучатьОповещения = Неопределено Тогда
		ПолучатьОповещения = Истина;
		ОбщегоНазначения.ХранилищеОбщихНастроекСохранить(
			"РКЦ_ПользовательскиеНастройкиРеакций", "ПолучатьОповещения", ПолучатьОповещения, , ИмяПользователя);
	КонецЕсли;
	
	Возврат ПолучатьОповещения;
	
КонецФункции

